--==================================================
-- UPDATE TRACKER
--==================================================

local function UpdateTracker(Player)

	local Billboard =
		Trackers[Player]

	if not Billboard then
		return
	end

	local Character =
		Player.Character

	if not Character then
		RemoveTracker(Player)
		return
	end

	local Root =
		Character:FindFirstChild(
			"HumanoidRootPart"
		)

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not Root or not Humanoid then
		RemoveTracker(Player)
		return
	end

	local Frame =
		Billboard:FindFirstChildOfClass("Frame")

	if not Frame then
		return
	end

	local HP =
		Frame:FindFirstChild("HP")

	local Team =
		Frame:FindFirstChild("Team")

	local HealthBackground =
		Frame:FindFirstChild(
			"HealthBackground"
		)

	local HealthBar = nil

	if HealthBackground then
		HealthBar =
			HealthBackground:FindFirstChild(
				"HealthBar"
			)
	end

	--==================================================
	-- HEALTH
	--==================================================

	local MaxHealth =
		math.max(
			Humanoid.MaxHealth,
			1
		)

	local Health =
		math.clamp(
			Humanoid.Health,
			0,
			MaxHealth
		)

	local Percent =
		Health / MaxHealth

	if HP then

		HP.Text =
			math.floor(Health)
			.. " / "
			.. math.floor(MaxHealth)
	end

	if HealthBar then

		HealthBar.Size =
			UDim2.new(
				Percent,
				0,
				1,
				0
			)

		if Percent > 0.6 then

			HealthBar.BackgroundColor3 =
				Color3.fromRGB(
					60,220,90
				)

		elseif Percent > 0.3 then

			HealthBar.BackgroundColor3 =
				Color3.fromRGB(
					240,190,50
				)

		else

			HealthBar.BackgroundColor3 =
				Color3.fromRGB(
					230,60,60
				)
		end
	end

	--==================================================
	-- TEAM
	--==================================================

	if Team then

		Team.Text =
			"Team: "
			.. (
				Player.Team
				and Player.Team.Name
				or "None"
			)
	end
end

--==================================================
-- FIND CLOSEST PLAYERS
--==================================================

local function UpdateTrackers()

	if not FreecamEnabled then
		return
	end

	if not TrackerEnabled then
		return
	end

	local List = {}

	for _,Player in ipairs(
		Players:GetPlayers()
	) do

		if Player ~= LocalPlayer then

			local Character =
				Player.Character

			if Character then

				local Root =
					Character:FindFirstChild(
						"HumanoidRootPart"
					)

				local Humanoid =
					Character:FindFirstChildOfClass(
						"Humanoid"
					)

				if Root
					and Humanoid
					and Humanoid.Health > 0 then

					local Distance =
						(
							Root.Position
							- CameraPosition
						).Magnitude

					if Distance <=
						TrackerDistance then

						table.insert(
							List,
							{
								Player = Player,
								Distance = Distance
							}
						)
					end
				end
			end
		end
	end

	table.sort(
		List,
		function(A,B)
			return A.Distance <
				B.Distance
		end
	)

	local Wanted = {}

	for i = 1,
		math.min(
			TrackerCount,
			#List
		) do

		local Player =
			List[i].Player

		Wanted[Player] = true

		if not Trackers[Player] then
			CreateTracker(Player)
		end

		UpdateTracker(Player)
	end

	for Player in pairs(Trackers) do

		if not Wanted[Player] then
			RemoveTracker(Player)
		end
	end
end

--==================================================
-- ENABLE
--==================================================

local function EnableFreecam()

	if FreecamEnabled then
		return
	end

	Camera =
		workspace.CurrentCamera

	CameraPosition =
		Camera.CFrame.Position

	local Look =
		Camera.CFrame.LookVector

	Yaw =
		math.deg(
			math.atan2(
				-Look.X,
				-Look.Z
			)
		)

	Pitch =
		math.deg(
			math.asin(
				math.clamp(
					Look.Y,
					-1,
					1
				)
			)
		)

	TargetYaw = Yaw
	TargetPitch = Pitch

	FreecamEnabled = true

	Camera.CameraType =
		Enum.CameraType.Scriptable

	Movement.Visible = true
	Vertical.Visible = true

	FreecamButton.Text =
		"FREECAM ON"
end

--==================================================
-- DISABLE
--==================================================

local function DisableFreecam()

	if not FreecamEnabled then
		return
	end

	FreecamEnabled = false

	for Name in pairs(Moving) do
		Moving[Name] = false
	end

	Movement.Visible = false
	Vertical.Visible = false

	for Player in pairs(Trackers) do
		RemoveTracker(Player)
	end

	Camera =
		workspace.CurrentCamera

	Camera.CameraType =
		Enum.CameraType.Custom

	local Character =
		LocalPlayer.Character

	local Humanoid =
		Character
		and Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if Humanoid then
		Camera.CameraSubject =
			Humanoid
	end

	FreecamButton.Text =
		"FREECAM"
end

--==================================================
-- TOGGLE
--==================================================

FreecamButton.Activated:Connect(function()

	if FreecamEnabled then
		DisableFreecam()
	else
		EnableFreecam()
	end
end)

--==================================================
-- CAMERA
--==================================================

RunService.RenderStepped:Connect(function(DeltaTime)

	if not FreecamEnabled then
		return
	end

	local Alpha =
		1 -
		math.exp(
			-Smoothness *
			DeltaTime
		)

	Yaw +=
		(TargetYaw - Yaw)
		* Alpha

	Pitch +=
		(TargetPitch - Pitch)
		* Alpha

	local X = 0
	local Z = 0
	local Y = 0

	if Moving.Forward then
		Z += 1
	end

	if Moving.Backward then
		Z -= 1
	end

	if Moving.Left then
		X -= 1
	end

	if Moving.Right then
		X += 1
	end

	if Moving.Up then
		Y += 1
	end

	if Moving.Down then
		Y -= 1
	end

	local Rotation =
		CFrame.Angles(
			0,
			math.rad(Yaw),
			0
		)

	local MovementVector =
		Rotation.RightVector * X
		+
		Rotation.LookVector * Z

	if MovementVector.Magnitude > 0 then

		CameraPosition +=
			MovementVector.Unit
			* CameraSpeed
			* DeltaTime
	end

	if Y ~= 0 then

		CameraPosition +=
			Vector3.new(0,Y,0)
			* CameraSpeed
			* DeltaTime
	end

	Camera.CFrame =
		CFrame.new(CameraPosition)
		* CFrame.Angles(
			0,
			math.rad(Yaw),
			0
		)
		* CFrame.Angles(
			math.rad(Pitch),
			0,
			0
		)

	TrackerTimer += DeltaTime

	if TrackerTimer >= TrackerInterval then

		TrackerTimer = 0
		UpdateTrackers()
	end
end)

--==================================================
-- MOBILE CAMERA
--==================================================

UIS.TouchStarted:Connect(function(Touch)

	if not FreecamEnabled then
		return
	end

	local Position =
		Touch.Position

	local Viewport =
		Camera.ViewportSize

	if Position.X <
		Viewport.X * 0.45 then
		return
	end

	if Position.Y < 80 then
		return
	end

	if Position.X >
		Viewport.X - 120
		and
		Position.Y >
		Viewport.Y - 280 then
		return
	end

	LookTouch = Touch
	LastLookPosition = Position
end)

UIS.TouchMoved:Connect(function(Touch)

	if not FreecamEnabled then
		return
	end

	if Touch ~= LookTouch then
		return
	end

	if not LastLookPosition then
		return
	end

	local Delta =
		Touch.Position
		- LastLookPosition

	TargetYaw -=
		Delta.X * LookSpeed

	TargetPitch -=
		Delta.Y * LookSpeed

	TargetPitch =
		math.clamp(
			TargetPitch,
			-MaxPitch,
			MaxPitch
		)

	LastLookPosition =
		Touch.Position
end)

UIS.TouchEnded:Connect(function(Touch)

	if Touch == LookTouch then

		LookTouch = nil
		LastLookPosition = nil
	end
end)

